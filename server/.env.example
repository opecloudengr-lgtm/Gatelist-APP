DATABASE_URL="postgresql://gatelist:gatelist_dev_pw@localhost:5432/gatelist?schema=public"
PORT=4000
NODE_ENV=development

JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

TICKET_SIGNING_SECRET=change-me-ticket-secret

EMAIL_FROM="GateList <no-reply@gatelist.app>"
# console: logs emails to stdout (default, good for local dev).
# smtp: sends real mail — fill in the SMTP_* vars below with your provider's
# credentials (SendGrid, SES, Mailgun, Postmark, Workspace/Gmail, etc. all
# speak SMTP).
EMAIL_TRANSPORT=console
# SMTP_HOST=smtp.sendgrid.net
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=apikey
# SMTP_PASSWORD=change-me

WEB_APP_URL=http://localhost:5173

CORS_ORIGIN=http://localhost:5173
